# Database (Supabase pooled Postgres or local SQLite)
DATABASE_URL=sqlite:///./repsync.db
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# TinyFish (Web Scraping, Fetch, Agent)
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# LLM Providers (Gemini and Groq)
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# Auth & Security
JWT_SECRET=repsync-super-secret-dev-jwt-token-change-in-prod
FRONTEND_ORIGIN=http://localhost:5173

# Mock Flags for CI and Offline Demo Mode
MOCK_TINYFISH=0
MOCK_LLM=0
